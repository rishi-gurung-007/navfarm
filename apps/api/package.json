{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "verify-demo-master-integrity": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/verify-demo-master-integrity.ts"
        }
      },
      "db-align-demo-bbp-masters": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "node --import tsx src/scripts/align-demo-bbp-masters.ts"
        }
      },
      "db-backfill-animal-age-at-entry": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "node --import tsx src/scripts/backfill-animal-age-at-entry.ts"
        }
      },
      "db-reseed-number-series": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "node --import tsx src/scripts/reseed-number-series.ts"
        }
      },
      "db-stamp-master-nob-lob": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/stamp-master-nob-lob.ts"
        }
      },
      "db-align-master-codes-to-series": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/align-master-codes-to-series.ts"
        }
      },
      "db-seed-farm-locations": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "node --import tsx src/scripts/seed-farm-locations.ts"
        }
      },
"db-seed-farm-masters": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "node --import tsx src/scripts/seed-farm-masters.ts"
        }
      },
"db-align-production-permissions": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/align-production-permissions.ts"
        }
      },
      "db-assign-operator-operational-area": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/assign-operator-operational-area.ts"
        }
      },
      "db-probe-farm-scope-users": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/probe-farm-scope-users.ts"
        }
      },
      "db-repair-demo-gl-dimensions": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/repair-demo-gl-dimensions.ts"
        }
      },
      "db-align-stages-to-tdd": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "node --import tsx src/scripts/align-stages-to-tdd.ts"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api:build:development"
          },
          "production": {
            "buildTarget": "api:build:production",
            "inspect": false,
            "watch": false
          }
        }
      },
      "start": {
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": ["build"],
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env dist/main.js",
          "env": {
            "NODE_ENV": "production",
            "NAVFARM_API_HOST": "127.0.0.1",
            "NAVFARM_API_PORT": "2877"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "db-generate-master": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "drizzle-kit generate --config drizzle.master.config.ts"
        }
      },
      "db-bootstrap": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/bootstrap-database.ts"
        }
      },
      "db-seed-system-master-data": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/seed-system-master-data.ts"
        }
      },
      "db-migrate-all-tenants": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/migrate-all-tenants.ts"
        }
      },
      "db-sync-nob-lob": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/sync-nob-lob.ts"
        }
      },
      "db-sync-currency-master": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/sync-currency-master.ts"
        }
      },
      "db-sync-locale-master": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/sync-locale-master.ts"
        }
      },
      "db-fix-non-uuid-company-ids": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/fix-non-uuid-company-ids.ts"
        }
      },
      "db-backfill-scheduler-headers": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/backfill-scheduler-headers.ts"
        }
      },
      "db-migrate-master": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/migrate-master.ts"
        }
      },
      "db-generate-tenant": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "drizzle-kit generate --config drizzle.config.ts"
        }
      },
      "db-seed-dev-tenant": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/seed-dev-tenant.ts"
        }
      },
      "db-setup-dev": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "commands": [
            "pnpm nx run api:db-bootstrap",
            "pnpm nx run api:db-seed-dev-tenant"
          ],
          "parallel": false
        }
      },
      "db-fresh-setup": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/api",
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/setup-fresh-database.ts"
        }
      },
      "db-seed-demo": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/seed-demo.ts",
          "cwd": "apps/api"
        }
      },
      "db-seed-piggery": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/seed-piggery-complete-data.ts",
          "cwd": "apps/api"
        }
      },
      "db-seed-gaps": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/seed-demo-gaps.ts",
          "cwd": "apps/api"
        }
      },
      "db-seed-activity-master": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/seed-activity-master.ts",
          "cwd": "apps/api"
        }
      },
      "db-seed-triplec-breed-lifecycles": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/seed-triplec-breed-lifecycles.ts",
          "cwd": "apps/api"
        }
      },
      "db-repair-demo-schedulers": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "../../node_modules/.bin/ts-node --transpile-only --project tsconfig.app.json -O '{\"module\":\"node16\",\"moduleResolution\":\"node16\",\"esModuleInterop\":true,\"ignoreDeprecations\":\"6.0\"}' src/scripts/repair-demo-schedulers.ts",
          "cwd": "apps/api"
        }
      },
      "db-demo-chapters": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "../../node_modules/.bin/ts-node --transpile-only --project tsconfig.app.json -O '{\"module\":\"node16\",\"moduleResolution\":\"node16\",\"esModuleInterop\":true,\"ignoreDeprecations\":\"6.0\"}' src/scripts/demo-chapters.ts",
          "cwd": "apps/api"
        }
      },
      "db-rebuild-demo": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --env-file-if-exists=.env --import tsx src/scripts/rebuild-demo.ts",
          "cwd": "apps/api"
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.6",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "mysql2": "^3.23.1",
    "nestjs-cls": "^6.2.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "swagger-ui-dist": "^5.32.9",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1"
  }
}

NODE_ENV=development
# App-specific host/port. The Windows production target explicitly uses
# 127.0.0.1:2877; PORT remains a fallback only for hosting platforms that
# allocate a port dynamically.
NAVFARM_API_HOST=0.0.0.0
NAVFARM_API_PORT=2877
API_PREFIX=api/v1
API_DOCS_PATH=api/docs
# The web app runs on port 3002 only: currently the assigned port is 3002 and
# other are occupied by other applications in the server.
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
UPLOADS_DIR=apps/api/uploads

# MySQL-wire-compatible control plane. The imported backend expects a
# nf_master database; tenant databases are named nf_<tenant_code>. Every NAVFarm
# database is nf_-prefixed so it cannot be mistaken for another app's on a shared MySQL.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=nf_master
# Set true for TiDB Cloud (or any host requiring TLS). Local MySQL: leave false.
DATABASE_SSL=false

# TiDB Cloud Serverless example — uncomment and fill in from the cluster's
# "Connect" dialog instead of the local values above:
# DATABASE_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# DATABASE_PORT=4000
# DATABASE_USERNAME=<user>.<cluster-id>
# DATABASE_PASSWORD=<cluster password>
# DATABASE_NAME=nf_master
# DATABASE_SSL=true

# Use a long, random value outside source control.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# At-rest encryption for sensitive columns (vendor bank details, etc.) — see encryption.service.ts.
# Use a long, random value outside source control.
ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Required by `pnpm nx db-bootstrap api`.
SYSTEM_TENANT_DATABASE=nf_system
SYSTEM_ADMIN_NAME="NAVFarm System Administrator"
SYSTEM_ADMIN_EMAIL=admin@navfarm.local
SYSTEM_ADMIN_PASSWORD=CHANGE_ME_TO_AT_LEAST_12_CHARACTERS

# Optional — used by `pnpm nx run api:db-seed-dev-tenant` (or the combined
# `pnpm nx run api:db-setup-dev`, which also runs db-bootstrap first) to
# create a ready-to-use dev tenant/company/admins. All have defaults if unset.
DEV_TENANT_CODE=devco
DEV_TENANT_NAME="Triple C"
DEV_COMPANY_CODE=DEVCO
DEV_COMPANY_NAME="Triple C"
# The four demo users and their password are fixed in seed-dev-tenant.ts and
# printed when the seed finishes — they are not configurable:
#   tenant.admin@triplec.local / company.admin@triplec.local
#   area.admin@triplec.local   / user@triplec.local          password 12345678
# Six DEV_*_ADMIN_* variables used to sit here naming logins that were never
# created. They are gone rather than left to mislead.

# Microsoft Dynamics 365 Business Central — OAuth 2.0 client credentials (Entra ID app).
# Keep real values only in apps/api/.env (gitignored). With BC_ENABLED=false nothing calls BC.
# The Entra app must also be added and enabled in BC → "Microsoft Entra Applications",
# with permission sets, or BC answers 401 "The server has rejected the client credentials".
BC_ENABLED=false
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=
BC_COMPANY_ID=
# Company NAME, for ODataV4 web services such as VendorCardApi.
BC_COMPANY_NAME=
# NAVFarm tenant and company (codes) that receive the BC data.
BC_NAVFARM_TENANT_CODE=
BC_NAVFARM_COMPANY_CODE=
# Vendor → Supplier sync (docs/bbp/BBP-BC-01-Vendor-Master-Integration.md).
BC_VENDOR_SERVICE=VendorCardApi
# FLAGGED = vendors with "NavFarm Sync" ticked; ALL = every vendor (rehearsal with --verify only).
BC_VENDOR_SYNC_SCOPE=FLAGGED
# BC = NAVFarm refuses to create suppliers (BC is the only source); NAVFARM = local creation still allowed.
BC_VENDOR_MASTER_SOURCE=NAVFARM
BC_VENDOR_SYNC_SCHEDULE_ENABLED=false
# Write the result back onto the BC vendor (Navfarm_Sync_Error, Navfarm_Error_Message, Sync_Status).
BC_VENDOR_WRITEBACK_ENABLED=false
# The BC developer's Sync_Status option values for "synced" and "error"; empty = Sync_Status is not written.
BC_VENDOR_SYNC_STATUS_SYNCED=
BC_VENDOR_SYNC_STATUS_ERROR=
# BC_VENDOR_MAX_DEACTIVATE_RATIO=0.5
# Optional overrides (defaults shown):
# BC_API_BASE_URL=https://api.businesscentral.dynamics.com
# BC_AUTHORITY_URL=https://login.microsoftonline.com
# BC_SCOPE=https://api.businesscentral.dynamics.com/.default
# BC_REQUEST_TIMEOUT_MS=30000
# BC_MAX_RETRIES=3
# BC_PAGE_SIZE=1000

# Optional SMTP/reset-password delivery.
FRONTEND_URL=http://localhost:3002
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@navfarm.local
SMTP_FROM_NAME="NAVFarm Support"

{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "//": "The NAVFarm web app runs on port 3002 only: currently the assigned port is 3002 and other are occupied by other applications in the server. Do not move it to 3000/3001 or anything else.",
  "nx": {
    "targets": {
      "dev": {
        "options": {
          "port": 3002
        }
      },
      "start": {
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/web",
          "command": "next start --hostname 0.0.0.0 --port 3002"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/web",
          "commands": [
            "next typegen",
            "tsc --noEmit -p tsconfig.json"
          ],
          "parallel": false
        }
      }
    }
  },
  "dependencies": {
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.2.0",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "tailwindcss": "^4.3.2"
  }
}
